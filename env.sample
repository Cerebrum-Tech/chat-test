# Erikli chat widget host. The deployed widget is the default; use http://10.0.2.2:5174
# for an Android emulator against a local Vite, or the LAN address for a physical device.
EXPO_PUBLIC_CAI_FRONTEND_URL=https://watersbot.footgolflegends.com
# Optional; leave blank to use the frontend's same-origin /api proxy
EXPO_PUBLIC_CAI_API_BASE_URL=
# Extra origins the chat may navigate to, comma-separated. Needed when the configured
# frontend forwards to another host that serves the same chat: that hop is cross-origin,
# and without the target listed the WebView hands it to the system browser and the
# injected session is lost. Keep it to hosts serving the chat itself.
EXPO_PUBLIC_CAI_ALLOWED_ORIGINS=https://waters.footgolflegends.com
EXPO_PUBLIC_CAI_LANGUAGE=tr-TR
EXPO_PUBLIC_CAI_COUNTRY=TR

# Service key for POST https://api.ceremeet.com/api/auth/watersLogin, which exchanges a CRM
# customer id for that customer's access token. Required — without it the login screen
# cannot mint a token.
#
# This is a credential and Expo BAKES every EXPO_PUBLIC_ value into the client bundle, so
# anyone with a build can sign in as any customer id. Use the pre-production key only, keep
# .env out of git, and do not distribute a build of this host. A production app must move
# this exchange behind its own backend rather than shipping the key.
EXPO_PUBLIC_CAI_WATERS_LOGIN_KEY=

# Sample users for the login screen: five slots, each a CRM customer id (the GUID that
# becomes consumer_id). A slot with a blank id is skipped; a blank label falls back to the
# id. These are identifiers, not credentials — the token is minted at sign-in. Any customer
# id can also be typed straight into the login screen.
EXPO_PUBLIC_CAI_SAMPLE_USER_1_LABEL=
EXPO_PUBLIC_CAI_SAMPLE_USER_1_CUSTOMER_ID=
EXPO_PUBLIC_CAI_SAMPLE_USER_2_LABEL=
EXPO_PUBLIC_CAI_SAMPLE_USER_2_CUSTOMER_ID=
EXPO_PUBLIC_CAI_SAMPLE_USER_3_LABEL=
EXPO_PUBLIC_CAI_SAMPLE_USER_3_CUSTOMER_ID=
EXPO_PUBLIC_CAI_SAMPLE_USER_4_LABEL=
EXPO_PUBLIC_CAI_SAMPLE_USER_4_CUSTOMER_ID=
EXPO_PUBLIC_CAI_SAMPLE_USER_5_LABEL=
EXPO_PUBLIC_CAI_SAMPLE_USER_5_CUSTOMER_ID=
